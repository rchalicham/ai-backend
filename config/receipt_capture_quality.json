{
  "receipt.geometry.validation": {
    "configurationId": "enterprise-geometry-validation-default",
    "version": "1",
    "contourLimits": {
      "boundsToleranceRatio": 0.01,
      "minimumAreaRatio": 0.05,
      "maximumAreaRatio": 0.98,
      "minimumAspectRatio": 1.1,
      "maximumAspectRatio": 15.0,
      "minimumRectangularity": 0.55,
      "minimumReceiptLikelihood": 0.55
    },
    "confidenceThresholds": {
      "contour": 0.65,
      "boundary": 0.7,
      "perspective": 0.6,
      "skew": 0.6,
      "coverage": 0.65,
      "overall": 0.65,
      "page": 0.68
    },
    "confidenceWeights": {
      "contour": 0.3,
      "boundary": 0.25,
      "perspective": 0.15,
      "skew": 0.15,
      "coverage": 0.15
    },
    "fallbackOrder": ["receipt_boundary", "page_boundary", "image_boundary"],
    "perspectiveLimits": {"maximumOpposingEdgeDistortion": 0.45, "maximumConditionNumber": 100000.0},
    "skewLimits": {"maximumReliableDegrees": 15.0, "minimumLineCount": 2},
    "pageDetection": {"minimumBrightPixelRatio": 0.62, "brightPixelLevel": 205, "boundaryInsetRatio": 0.002},
    "criticalFactors": ["rotation", "blur", "text_resolution", "resolution", "contrast"],
    "advisoryFactors": ["perspective", "brightness", "shadow", "coverage", "occlusion", "edge_clipping", "completeness", "noise", "skew"]
  },
  "receipt.capture.quality": {
