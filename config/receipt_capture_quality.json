      "occlusion": {"poor": 0.0, "good": 0.32, "darkPixelLevel": 28.0},
      "edge_clipping": {"poor": 0.0, "good": 0.035},
      "completeness": {"poor": 0.15, "good": 0.8},
      "noise": {"poor": 1.0, "good": 16.0},
      "skew": {"poor": 0.0, "good": 12.0}
    },
    "weights": {
      "rotation": 0.06,
      "perspective": 0.06,
      "blur": 0.12,
      "contrast": 0.07,
      "brightness": 0.05,
      "shadow": 0.05,
      "coverage": 0.14,
      "text_resolution": 0.15,
      "resolution": 0.08,
      "occlusion": 0.06,
      "edge_clipping": 0.05,
      "completeness": 0.05,
      "noise": 0.03,
      "skew": 0.03
    },
    "recommendations": {
      "rotation": "Rotate the receipt vertically.",
      "perspective": "Hold the camera parallel to the receipt.",
      "blur": "Hold still and retake the photo in focus.",
      "contrast": "Place the receipt on a contrasting background.",
      "brightness": "Increase even lighting without glare.",
      "shadow": "Move hands and objects away from the receipt.",
      "coverage": "Move closer and fill the camera frame with the receipt.",
      "text_resolution": "Move closer so printed characters are clearly readable.",
      "resolution": "Use a higher-resolution camera image.",
      "occlusion": "Uncover the complete receipt.",
      "edge_clipping": "Keep every receipt edge inside the frame.",
      "completeness": "Capture the entire receipt from header through footer.",
      "noise": "Clean the lens and use steady, even lighting.",
      "skew": "Straighten the receipt before capturing it."
    }
  },
  "receipt.document.review": {
    "configurationId": "enterprise-document-family-review-default",
    "version": "1",
    "defaultPolicy": {
      "requiredFields": [], "optionalFields": ["merchant", "date", "total"],
      "expectedSections": [], "expectedItems": {},
      "minimumCompleteness": 0.45, "minimumConfidence": 0.45
    },
    "familyPolicies": {
      "retail_receipt": {"requiredFields":["merchant","total","items"],"optionalFields":["address","date","payment_method","tax"],"expectedSections":["merchant_zone","item_zone","financial_zone"],"expectedItems":{"minimum":1},"minimumCompleteness":0.72,"minimumConfidence":0.65},
      "restaurant_receipt": {"requiredFields":["merchant","total","items"],"optionalFields":["address","date","tax","tip","payment_method"],"expectedSections":["merchant_zone","item_zone","financial_zone"],"expectedItems":{"minimum":1},"minimumCompleteness":0.72,"minimumConfidence":0.65},
      "fuel_receipt": {"requiredFields":["merchant","total"],"optionalFields":["address","date","fuel_quantity","unit_price","payment_method"],"expectedSections":["merchant_zone","financial_zone"],"expectedItems":{"minimum":0},"minimumCompleteness":0.7,"minimumConfidence":0.62},
      "pharmacy_receipt": {"requiredFields":["merchant","total"],"optionalFields":["address","date","items","payment_method"],"expectedSections":["merchant_zone","financial_zone"],"expectedItems":{"minimum":0},"minimumCompleteness":0.7,"minimumConfidence":0.65},
      "payment_slip": {"requiredFields":["merchant","total","payment_method","card_brand","card_last_four","approval_code"],"optionalFields":["address","date","reference"],"expectedSections":["merchant_zone","financial_zone","payment_zone"],"expectedItems":{"minimum":0,"maximum":0},"minimumCompleteness":0.7,"minimumConfidence":0.6},
      "credit_card_slip": {"requiredFields":["merchant","total","card_brand","card_last_four","approval_code"],"optionalFields":["address","date","payment_method","reference"],"expectedSections":["merchant_zone","financial_zone","payment_zone"],"expectedItems":{"minimum":0,"maximum":0},"minimumCompleteness":0.7,"minimumConfidence":0.6},
      "refund_receipt": {"requiredFields":["merchant","total"],"optionalFields":["date","items","payment_method","reference"],"expectedSections":["merchant_zone","financial_zone"],"expectedItems":{"minimum":0},"minimumCompleteness":0.68,"minimumConfidence":0.62},
      "return_receipt": {"requiredFields":["merchant","total"],"optionalFields":["date","items","payment_method","reference"],"expectedSections":["merchant_zone","financial_zone"],"expectedItems":{"minimum":0},"minimumCompleteness":0.68,"minimumConfidence":0.62},
      "invoice": {"requiredFields":["merchant","invoice_number","total","due_date","items"],"optionalFields":["address","date","tax"],"expectedSections":["merchant_zone","item_zone","financial_zone","reference_zone"],"expectedItems":{"minimum":1},"minimumCompleteness":0.72,"minimumConfidence":0.65},
      "statement": {"requiredFields":["merchant","date"],"optionalFields":["address","total","reference","items"],"expectedSections":["merchant_zone","financial_zone"],"expectedItems":{"minimum":0},"minimumCompleteness":0.66,"minimumConfidence":0.6},
      "warranty": {"requiredFields":["merchant","product","serial_number","coverage"],"optionalFields":["date","items","address"],"expectedSections":["merchant_zone","reference_zone"],"expectedItems":{"minimum":0},"minimumCompleteness":0.68,"minimumConfidence":0.62},
      "donation_receipt": {"requiredFields":["merchant","total","date"],"optionalFields":["address","reference","payment_method"],"expectedSections":["merchant_zone","financial_zone"],"expectedItems":{"minimum":0,"maximum":0},"minimumCompleteness":0.68,"minimumConfidence":0.62},
      "unknown": {"requiredFields":[],"optionalFields":["merchant","date","total"],"expectedSections":[],"expectedItems":{},"minimumCompleteness":0.45,"minimumConfidence":0.45,"completionAllowed":false}
    },
    "fieldAliases": {
      "merchant":["merchant","vendor"], "address":["address"], "date":["date","transaction_date"],
      "total":["total","amount"], "items":["items","products"], "payment_method":["payment_method","payment"],
      "card_brand":["card_brand"], "card_last_four":["card_last_four","last_four"], "approval_code":["approval_code","authorization_code"],
      "invoice_number":["invoice_number","invoice"], "due_date":["due_date"], "reference":["reference","reference_number"],
      "tax":["tax"], "tip":["tip"], "product":["product","products"], "serial_number":["serial_number"], "coverage":["coverage"],
      "fuel_quantity":["fuel_quantity","quantity"], "unit_price":["unit_price"]
    },
    "weights": {"requiredFields":0.42,"optionalFields":0.06,"sections":0.12,"items":0.1,"grammar":0.08,"constraints":0.08,"projection":0.14},
    "confidenceWeights": {"family":0.2,"semantic":0.3,"projection":0.25,"reasoning":0.1,"quality":0.15},
    "decisions": {
      "completed":{"label":"Completed","processingState":"completed","requiresHumanReview":false,"recommendations":[]},
      "completed_with_warnings":{"label":"Completed With Warnings","processingState":"completed","requiresHumanReview":false,"recommendations":[]},
      "needs_user_action":{"label":"Needs User Action","processingState":"needs_user_action","requiresHumanReview":false,"recommendations":[]},
      "human_review_required":{"label":"Human Review Required","processingState":"human_review_required","requiresHumanReview":true,"recommendations":["default_review"]},
      "manual_verification":{"label":"Manual Verification","processingState":"human_review_required","requiresHumanReview":true,"recommendations":["default_review"]},
      "insufficient_evidence":{"label":"Insufficient Evidence","processingState":"human_review_required","requiresHumanReview":true,"recommendations":["default_review"]},
      "unrecoverable":{"label":"Unrecoverable","processingState":"failed","requiresHumanReview":false,"recommendations":[]}
    },
    "qualityResolution": {
      "reliableStates":["reliable","fallback_reliable"],
      "advisoryFactors":["coverage","perspective","shadow","occlusion","edge_clipping","completeness","noise","skew"]
    },
    "recommendations": {
      "default_review":{"message":"Verify the missing business facts against the document.","reason":"A required field for this document family is unavailable.","priority":"high"},
      "quality_blur":{"message":"Retake the image with the text in focus.","reason":"Text sharpness remains below policy.","priority":"high"},
      "quality_text_resolution":{"message":"Move closer so the printed text is readable.","reason":"Effective text resolution remains below policy.","priority":"high"},
      "quality_rotation":{"message":"Rotate the document and capture it again.","reason":"Orientation remains unsuitable for OCR.","priority":"high"},
      "quality_resolution":{"message":"Upload a higher-resolution image.","reason":"Image resolution remains below policy.","priority":"high"},
      "quality_contrast":{"message":"Recapture with stronger, even contrast.","reason":"Text contrast remains below policy.","priority":"high"}
    },
    "explanations": {
      "completed":{"title":"Document complete","message":"The document satisfies its family review policy; human review is not required."},
      "completed_with_warnings":{"title":"Document complete with warnings","message":"The required family facts are present and remaining uncertainty is advisory."},
      "needs_user_action":{"title":"A better capture is needed","message":"An unresolved critical quality condition prevents reliable processing."},
      "human_review_required":{"title":"Document requires review","message":"One or more facts required by this document family could not be confirmed."},
      "manual_verification":{"title":"Manual verification required","message":"Semantic completeness is below the configured family policy."},
      "insufficient_evidence":{"title":"Insufficient evidence","message":"There is not enough semantic evidence to complete this document."},
      "unrecoverable":{"title":"Document cannot be completed","message":"The available evidence cannot be recovered automatically."}
    }
  },
  "receipt.processing.experience": {
    "configurationId": "enterprise-receipt-processing-default",
    "version": "1",
    "thresholds": {"businessProjectionDisplay": 0.72},
    "sourceStatusMappings": {"initial":"processing","uploaded":"uploaded","queued":"queued","running":"running","reprocessing":"running","cancelled":"cancelled","failed":"failed","completed":"completed"},
    "actions": {"retry":{"label":"Retry","icon":"sync-alt"},"rescan":{"label":"Rescan","icon":"camera"},"humanReview":{"label":"Human Review","icon":"user-check"},"viewDetails":{"label":"View Details","hideLabel":"Hide Details","icon":"info-circle"}},
    "labels": {"cardTitle":"Receipt processing","currentStage":"Current stage","recoverability":"Recoverability","confidence":"Confidence","recommendations":"What to do next","why":"Why","policy":"Policy","timeline":"Receipt processing timeline","statusUnavailable":"Status unavailable"},
    "stageStates": {
      "waiting":{"color":"var(--og-text-secondary, #64748b)","icon":"clock"},
      "running":{"color":"var(--og-status-info, #2563eb)","icon":"spinner"},
      "success":{"color":"var(--og-status-success, #15803d)","icon":"check"},
      "warning":{"color":"var(--og-status-warning, #d97706)","icon":"exclamation"},
      "skipped":{"color":"var(--og-text-secondary, #64748b)","icon":"minus"},
      "failed":{"color":"var(--og-status-danger, #dc2626)","icon":"times"}
    },
    "states": [
      {"key":"uploaded","label":"Uploaded","color":"var(--og-status-info, #2563eb)","icon":"upload"},
      {"key":"queued","label":"Queued","color":"var(--og-text-secondary, #64748b)","icon":"clock"},
      {"key":"running","label":"Running","color":"var(--og-status-info, #2563eb)","icon":"spinner"},
      {"key":"processing","label":"Processing","color":"var(--og-status-info, #2563eb)","icon":"spinner"},
      {"key":"completed","label":"Completed","color":"var(--og-status-success, #15803d)","icon":"check-circle"},
      {"key":"needs_user_action","label":"Needs User Action","color":"var(--og-status-warning, #d97706)","icon":"camera"},
      {"key":"human_review_required","label":"Human Review Required","color":"var(--og-status-warning, #d97706)","icon":"user-check"},
      {"key":"failed","label":"Failed","color":"var(--og-status-danger, #dc2626)","icon":"exclamation-circle"},
      {"key":"cancelled","label":"Cancelled","color":"var(--og-text-secondary, #64748b)","icon":"ban"},
      {"key":"unknown","label":"Status Unavailable","color":"var(--og-text-secondary, #64748b)","icon":"question-circle"}
    ],
    "stages": [
      {"key":"upload","label":"Upload","evidencePath":"receiptAgent","explanations":{"waiting":"Waiting to upload.","running":"Uploading receipt.","success":"Receipt uploaded.","warning":"Upload completed with a warning.","skipped":"Upload information unavailable.","failed":"Receipt upload failed."}},
      {"key":"geometry","label":"Geometry","evidencePath":"receiptQuality","explanations":{"waiting":"Waiting to inspect the image.","running":"Inspecting receipt shape.","success":"Receipt shape inspected.","warning":"Receipt shape may need review.","skipped":"Image inspection was skipped.","failed":"Unable to inspect the image."}},
      {"key":"quality_validation","label":"Quality Validation","evidencePath":"receiptQuality","confidencePath":"receiptQuality.overallScore","explanations":{"waiting":"Waiting for capture validation.","running":"Checking image readiness.","success":"Image is ready for processing.","warning":"Image quality needs review.","skipped":"Quality validation was skipped.","failed":"Image is not clear enough to process."}},
      {"key":"ocr","label":"Text Recognition","evidencePath":"receiptDocument","explanations":{"waiting":"Waiting to read the receipt.","running":"Reading receipt text.","success":"Receipt text read successfully.","warning":"Some receipt text is uncertain.","skipped":"Text recognition was not run.","failed":"Receipt text could not be read."}},
      {"key":"document_family","label":"Receipt Type","evidencePath":"documentFamilyContext","confidencePath":"documentFamilyContext.activation.confidence","explanations":{"waiting":"Waiting to identify the receipt type.","running":"Identifying receipt type.","success":"Receipt type identified.","warning":"Receipt type is uncertain.","skipped":"Receipt type identification was skipped.","failed":"Receipt type could not be identified."}},
      {"key":"grammar","label":"Document Interpretation","evidencePath":"receiptGrammar","explanations":{"waiting":"Waiting to interpret receipt structure.","running":"Interpreting receipt structure.","success":"Receipt structure interpreted.","warning":"Receipt structure needs review.","skipped":"Structure interpretation was skipped.","failed":"Receipt structure could not be interpreted."}},
      {"key":"constraint_solver","label":"Validation","evidencePath":"receiptConstraintResult","explanations":{"waiting":"Waiting to validate receipt facts.","running":"Validating receipt facts.","success":"Receipt facts validated.","warning":"Some receipt facts need review.","skipped":"Fact validation was skipped.","failed":"Receipt facts did not validate."}},
      {"key":"product_intelligence","label":"Products","evidencePath":"productIntelligence","explanations":{"waiting":"Waiting to understand products.","running":"Understanding purchased products.","success":"Products understood.","warning":"Some products need review.","skipped":"Product interpretation was skipped.","failed":"Products could not be interpreted."}},
      {"key":"knowledge_graph","label":"Business Context","evidencePath":"enterpriseKnowledgeGraph","explanations":{"waiting":"Waiting for business context.","running":"Connecting business context.","success":"Business context connected.","warning":"Business context is limited.","skipped":"Business context was skipped.","failed":"Business context was unavailable."}},
      {"key":"learning","label":"Learning","evidencePath":"enterpriseLearning","explanations":{"waiting":"Waiting for approved learning.","running":"Applying approved learning.","success":"Approved learning applied.","warning":"Learning suggestions need review.","skipped":"Learning was skipped.","failed":"Learning was unavailable."}},
      {"key":"reasoning","label":"Business Reasoning","evidencePath":"enterpriseReasoning","confidencePath":"enterpriseReasoning.confidence","explanations":{"waiting":"Waiting for business reasoning.","running":"Reasoning over validated facts.","success":"Business reasoning completed.","warning":"Business reasoning needs review.","skipped":"Business reasoning was skipped.","failed":"Business reasoning was unavailable."}},
      {"key":"projection","label":"Business View","evidencePath":"businessProjection","confidencePath":"businessProjection.overall_confidence.display","explanations":{"waiting":"Waiting to prepare the business view.","running":"Preparing the business view.","success":"Business view prepared.","warning":"Business view needs review.","skipped":"Business view was withheld.","failed":"Business view could not be prepared."}},
      {"key":"business_intelligence","label":"Business Intelligence","evidencePath":"receiptIntelligenceSnapshot","explanations":{"waiting":"Waiting to complete processing.","running":"Finalizing receipt intelligence.","success":"Receipt processing completed.","warning":"Receipt intelligence needs review.","skipped":"Business intelligence was skipped.","failed":"Receipt processing could not complete."}}
    ],
    "recoverabilityRules": {
      "rescan":{"score":0.95,"confidence":0.96,"recommendation":"A clearer capture is highly likely to succeed."},
      "manual_edit":{"score":0.72,"confidence":0.82,"recommendation":"Review and correct the visible receipt fields manually."},
      "human_review":{"score":0.84,"confidence":0.9,"recommendation":"Send this receipt to a reviewer for confirmation."},
      "unrecoverable":{"score":0.05,"confidence":0.85,"recommendation":"The source document cannot be recovered."},
      "already_complete":{"score":1.0,"confidence":1.0,"recommendation":"No recovery action is required."}
    },
    "stateRecoverabilityMappings":{"uploaded":"human_review","queued":"human_review","running":"human_review","processing":"human_review","completed":"already_complete","needs_user_action":"rescan","human_review_required":"human_review","failed":"manual_edit","cancelled":"manual_edit","unknown":"human_review"},
    "recoverabilitySignalMappings":{"quality:quality_failure":"rescan","agent:unrecoverable":"unrecoverable"},
    "stateRecommendations": {"human_review_required":["send_human_review"],"failed":["review_manually"],"processing":[],"completed":[],"unknown":["review_manually"]},
    "recommendations": {
      "capture_blur":{"label":"Retake photo","why":"The receipt text is blurred.","action":"Hold the camera steady and retake the photo.","priority":"high"},
      "capture_rotation":{"label":"Rotate vertically","why":"The receipt orientation is unsuitable.","action":"Hold the receipt vertically and retake the photo.","priority":"high"},
      "capture_coverage":{"label":"Fill camera frame","why":"The receipt is too small in the image.","action":"Move closer and fill the frame with the receipt.","priority":"high"},
      "capture_text_resolution":{"label":"Move closer","why":"Printed characters are too small to read reliably.","action":"Move closer until the text is sharp and readable.","priority":"high"},
      "capture_resolution":{"label":"Use higher resolution","why":"The image does not contain enough detail.","action":"Retake the photo with the original camera resolution.","priority":"high"},
      "capture_brightness":{"label":"Increase lighting","why":"The receipt is too dark.","action":"Use brighter, even lighting without glare.","priority":"medium"},
      "capture_shadow":{"label":"Reduce shadows","why":"Uneven shadows obscure receipt text.","action":"Move hands and objects away and use even lighting.","priority":"medium"},
      "capture_occlusion":{"label":"Uncover receipt","why":"Part of the receipt may be hidden.","action":"Place the complete receipt flat and unobstructed.","priority":"high"},
      "capture_edge_clipping":{"label":"Include all edges","why":"Receipt edges are outside the image.","action":"Keep the full receipt inside the camera frame.","priority":"high"},
      "capture_perspective":{"label":"Hold camera parallel","why":"The receipt is photographed at an angle.","action":"Hold the camera directly above the receipt.","priority":"medium"},
      "capture_contrast":{"label":"Improve contrast","why":"Receipt text does not contrast with its background.","action":"Use even light and a contrasting surface.","priority":"medium"},
      "capture_completeness":{"label":"Capture complete receipt","why":"The full receipt was not detected.","action":"Capture from merchant header through receipt footer.","priority":"high"},
      "capture_noise":{"label":"Clean lens","why":"Image noise reduces text clarity.","action":"Clean the lens and retake in steady lighting.","priority":"medium"},
      "capture_skew":{"label":"Straighten receipt","why":"The receipt is not aligned.","action":"Place the receipt straight before capture.","priority":"medium"},
      "review_manually":{"label":"Review manually","why":"Automatic processing could not produce a reliable business view.","action":"Compare visible fields with the receipt image.","priority":"high"},
      "send_human_review":{"label":"Send to Human Review","why":"Some extracted facts require confirmation.","action":"Submit the receipt to the review queue.","priority":"medium"},
      "upload_pdf":{"label":"Upload PDF instead","why":"A source PDF may retain more readable detail.","action":"Upload the original PDF when available.","priority":"medium"}
    },
    "explanations": {
      "uploaded":{"title":"Receipt uploaded","message":"The receipt is ready to enter the processing queue."},
      "queued":{"title":"Receipt queued","message":"The receipt is waiting to be processed."},
      "running":{"title":"Processing started","message":"The receipt is currently being processed."},
      "needs_user_action":{"title":"A better image is needed","message":"This receipt image is not clear enough for reliable processing."},
      "human_review_required":{"title":"Receipt requires review","message":"Some receipt details could not be confirmed automatically."},
      "failed":{"title":"Receipt processing failed","message":"A reliable result could not be produced."},
      "cancelled":{"title":"Processing cancelled","message":"Receipt processing was cancelled."},
      "processing":{"title":"Processing receipt","message":"The receipt is being converted into a business-ready view."},
      "completed":{"title":"Receipt ready","message":"The receipt has been processed successfully."},
      "unknown":{"title":"Status unavailable","message":"Processing information is not currently available."},
      "quality_blur":{"title":"Image too blurry","message":"The printed text is not sharp enough to read reliably."},
      "quality_rotation":{"title":"Receipt needs rotation","message":"The receipt orientation prevents reliable reading."},
      "quality_coverage":{"title":"Receipt too small","message":"The receipt occupies too little of the image."},
      "quality_text_resolution":{"title":"Receipt text too small","message":"Printed characters do not contain enough detail to read reliably."},
      "quality_resolution":{"title":"Image resolution too low","message":"The image does not contain enough detail for reliable processing."},
      "quality_shadow":{"title":"Shadows obscure the receipt","message":"Uneven lighting makes parts of the receipt difficult to read."},
      "quality_occlusion":{"title":"Receipt partially visible","message":"Part of the receipt appears hidden or outside the frame."},
      "quality_edge_clipping":{"title":"Receipt partially visible","message":"One or more receipt edges are outside the captured image."}
    }
  }
}
